# MedQueue Backend - Environment Configuration
# Copy this file to .env and fill in your values

# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MySQL Database ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medqueue_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ── JWT Secret ─────────────────────────────────────────
JWT_SECRET=medqueue_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# ── CORS (Frontend URL) ────────────────────────────────
FRONTEND_URL=http://localhost:5173
